# Docker не читает .gitignore. Без этих строк .env с боевыми кредами Neon
# уехал бы внутрь образа, а образ пушится в реестр.
.env
.env.*
!.env.example

# Ставится и собирается внутри образа
node_modules
dist
build

# Клиент Prisma генерируется в образе (pnpm db:generate)
libs/prisma/src/generated

# В рантайме не нужны. Тесты в монорепе лежат по apps/<app>/test, поэтому
# шаблон со звёздочкой, а не просто `test`.
**/test
**/*.spec.ts
coverage
*.tsbuildinfo

# Инфраструктура: используется Jenkins-агентом, внутри образа не нужна
Dockerfile
.dockerignore
Jenkinsfile
deployment.yaml
preparingDeploy.sh

.git
.gitignore
.claude
.idea
.vscode
*.log
README.md
CLAUDE.md
