# Neon Postgres
# Neon Console -> Project -> Connect -> "Connection string" (Pooled connection)
# Pooled (-pooler) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Direct (no -pooler) — used by prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# JWT
# Сгенерировать каждый секрет отдельно:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Секреты access и refresh должны различаться: с общим секретом access-токен
# структурно годится как refresh.
JWT_ACCESS_SECRET="<64 hex-символа>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<64 hex-символа, отличных от access>"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend base URL for links in emails (confirmation, recovery)
FRONTEND_URL="http://localhost:3001"

# Gmail (nodemailer) — as in HW01
EMAIL_USER=""
EMAIL_PASS=""

# Google reCAPTCHA v2 (checkbox) — password-recovery
# SITE_KEY нужен фронту; на бэке проверяем токен через SECRET_KEY.
# RECAPTCHA_ENABLED=false — пропуск проверки (local / tests). В production = true.
RECAPTCHA_ENABLED="false"
RECAPTCHA_SECRET_KEY=""

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI должен совпадать с GOOGLE_CALLBACK_URL один в один,
# включая префикс /api. Scope: openid email profile.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/oauth/google/callback"

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL должен совпадать с GITHUB_CALLBACK_URL.
# Scope: read:user user:email.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/oauth/github/callback"
