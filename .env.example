# Neon Postgres
# Neon Console -> Project -> Connect -> "Connection string" (Pooled connection)
# Pooled (-pooler) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Direct (no -pooler) — used by prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require"

PORT=3000

# JWT
# Сгенерировать каждый секрет отдельно:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Секреты access и refresh должны различаться: с общим секретом access-токен
# структурно годится как refresh.
JWT_ACCESS_SECRET="<64 hex-символа>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<64 hex-символа, отличных от access>"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend base URL for links in emails (confirmation, recovery)
FRONTEND_URL="http://localhost:3001"

# Gmail (nodemailer) — as in HW01
EMAIL_USER=""
EMAIL_PASS=""

# Google reCAPTCHA v2 (checkbox) — password-recovery
# SITE_KEY нужен фронту; на бэке проверяем токен через SECRET_KEY.
# RECAPTCHA_ENABLED=false — пропуск проверки (local / tests). В production = true.
RECAPTCHA_ENABLED="false"
RECAPTCHA_SECRET_KEY=""
