# Neon Postgres
# Neon Console -> Project -> Connect -> "Connection string" (Pooled connection)
# Pooled (-pooler) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Direct (no -pooler) — used by prisma migrate / db push
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require"

PORT=3000

# JWT
# Сгенерировать каждый секрет отдельно:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Секреты access и refresh должны различаться: с общим секретом access-токен
# структурно годится как refresh.
JWT_ACCESS_SECRET="<64 hex-символа>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<64 hex-символа, отличных от access>"
JWT_REFRESH_EXPIRES_IN="7d"

# RabbitMQ
# Транспорт между gateway и микросервисами. Нужен всем трём приложениям:
# gateway шлёт сообщения, auth и notifications слушают свои очереди.
# Локально проще всего поднять брокер контейнером:
#   docker run -d -p 5672:5672 -p 15672:15672 rabbitmq:4-management
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
# Имена очередей. Менять есть смысл, когда на одном брокере живёт несколько
# окружений: очередь с общим именем они поделят между собой.
RABBITMQ_AUTH_QUEUE="auth_queue"
RABBITMQ_NOTIFICATIONS_QUEUE="notifications_queue"

# SMTP — нужен только сервису notifications
MAIL_HOST="smtp.gmail.com"
# 465 — implicit TLS, остальные порты поднимают шифрование через STARTTLS
MAIL_PORT=587
MAIL_USER="<логин на SMTP-сервере>"
# Для Gmail это пароль приложения, а не пароль от аккаунта
MAIL_PASSWORD="<пароль приложения>"
MAIL_FROM="Inctagram <no-reply@example.com>"
