// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Datasource URL живёт в prisma.config.ts (Prisma 7), а не здесь.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // NestJS собирается в CommonJS; без этого генератор выдаёт ESM с
  // import.meta.url, и dist падает на старте.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  body      String
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Пост без автора не имеет смысла — удаляем каскадом вместе с пользователем.
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}
