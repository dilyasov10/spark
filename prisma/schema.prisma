// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Datasource URL живёт в prisma.config.ts (Prisma 7), а не здесь.

generator client {
  provider = "prisma-client"
  output   = "../libs/prisma/src/generated/prisma"
  // NestJS собирается в CommonJS; без этого генератор выдаёт ESM с
  // import.meta.url, и dist падает на старте.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  // Необязателен: до подтверждения email пароль уже задан, но регистрации
  // через внешних провайдеров пароля могут не иметь.
  passwordHash String?
  firstName    String
  lastName     String
  // Пока false — вход запрещён (login отдаёт EMAIL_NOT_CONFIRMED).
  isConfirmed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts             Post[]
  emailConfirmation EmailConfirmation?
  passwordRecovery  PasswordRecovery?
  sessions          Session[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  body      String
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Пост без автора не имеет смысла — удаляем каскадом вместе с пользователем.
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// Код подтверждения email при регистрации. Один активный код на пользователя
// (userId @unique) — повторная отправка перезаписывает его через upsert.
model EmailConfirmation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
}

// Код восстановления пароля. Так же один активный код на пользователя.
model PasswordRecovery {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
}

// Сессия устройства. Пока используется только для инвалидации всех сессий при
// смене пароля (new-password); выпуск сессий на входе — задел на будущее.
model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  ip               String
  deviceName       String
  refreshTokenHash String
  lastActiveDate   DateTime
  expiresAt        DateTime

  @@unique([userId, deviceId])
  @@index([userId])
}
